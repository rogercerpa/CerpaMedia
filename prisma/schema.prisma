generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id             String    @id @default(cuid())
  title          String    @unique
  shortDesc      String    @db.Text
  longDesc       String    @db.Text
  priceLabel     String
  ctaLabel       String
  ctaUrl         String
  sortOrder      Int       @default(0)
  published      Boolean   @default(false)
  // New CMS fields (additive only, with defaults/optional to preserve existing data)
  slug           String?   @unique
  outcome        String?   @db.Text
  description    String?   @db.Text
  features       String[]  @default([])
  price          Float?
  priceNote      String?   @db.Text
  badgeText      String?
  featured       Boolean   @default(false)
  seoTitle       String?
  seoDescription String?   @db.Text
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, sortOrder])
  @@index([slug])
  @@index([featured])
  @@index([deletedAt])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekday])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Booking {
  id               String    @id @default(cuid())
  startTime        DateTime
  endTime          DateTime
  status           String    @default("confirmed")
  customerName     String
  customerEmail    String
  customerPhone    String
  customerCompany  String
  serviceInterest  String
  platformPref     String
  intakeAnswers    Json?
  stripeSessionId  String?   @unique
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, startTime])
  @@index([customerEmail])
  @@index([serviceInterest])
}

model CheckoutHold {
  id              String   @id @default(cuid())
  startTime       DateTime
  endTime         DateTime
  customerName    String
  customerEmail   String
  customerPhone   String
  customerCompany String
  serviceInterest String
  platformPref    String
  intakeAnswers   Json?
  notes           String?  @db.Text
  stripeSessionId String?  @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([startTime, endTime])
  @@index([expiresAt])
  @@index([stripeSessionId])
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email, expiresAt])
}

model AdminSession {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([email, expiresAt])
}

model BookingSettings {
  id             String   @id @default(cuid())
  slotLengthMin  Int      @default(60)
  bufferMin      Int      @default(15)
  minLeadTimeHrs Int      @default(24)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DateAvailability {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String
  endTime   String
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model InsightPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String    @db.Text
  body        String    @db.Text
  publishedAt DateTime?
  tags        String[]
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}
