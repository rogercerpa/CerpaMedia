generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Service {
  id             String    @id @default(cuid())
  title          String    @unique
  shortDesc      String    @db.Text
  longDesc       String    @db.Text
  priceLabel     String
  ctaLabel       String
  ctaUrl         String
  sortOrder      Int       @default(0)
  published      Boolean   @default(false)
  // New CMS fields (additive only, with defaults/optional to preserve existing data)
  slug           String?   @unique
  outcome        String?   @db.Text
  description    String?   @db.Text
  features       String[]  @default([])
  price          Float?
  priceNote      String?   @db.Text
  badgeText      String?
  featured       Boolean   @default(false)
  seoTitle       String?
  seoDescription String?   @db.Text
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, sortOrder])
  @@index([slug])
  @@index([featured])
  @@index([deletedAt])
}

model AvailabilityRule {
  id        String   @id @default(cuid())
  weekday   Int
  startTime String
  endTime   String
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([weekday])
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Booking {
  id               String    @id @default(cuid())
  startTime        DateTime
  endTime          DateTime
  status           String    @default("confirmed")
  customerName     String
  customerEmail    String
  customerPhone    String
  customerCompany  String
  serviceInterest  String
  platformPref     String
  intakeAnswers    Json?
  stripeSessionId  String?   @unique
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, startTime])
  @@index([customerEmail])
  @@index([serviceInterest])
}

model CheckoutHold {
  id              String   @id @default(cuid())
  startTime       DateTime
  endTime         DateTime
  customerName    String
  customerEmail   String
  customerPhone   String
  customerCompany String
  serviceInterest String
  platformPref    String
  intakeAnswers   Json?
  notes           String?  @db.Text
  stripeSessionId String?  @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([startTime, endTime])
  @@index([expiresAt])
  @@index([stripeSessionId])
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email, expiresAt])
}

model AdminSession {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([email, expiresAt])
}

model BookingSettings {
  id             String   @id @default(cuid())
  slotLengthMin  Int      @default(60)
  bufferMin      Int      @default(15)
  minLeadTimeHrs Int      @default(24)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DateAvailability {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String
  endTime   String
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model InsightPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  summary     String    @db.Text
  body        String    @db.Text
  publishedAt DateTime?
  tags        String[]
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model FaqItem {
  id        String    @id @default(cuid())
  question  String    @db.Text
  answer    String    @db.Text
  sortOrder Int       @default(0)
  published Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([published, sortOrder])
  @@index([deletedAt])
}

model Testimonial {
  id        String    @id @default(cuid())
  name      String
  role      String
  quote     String    @db.Text
  link      String?
  sortOrder Int       @default(0)
  published Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([published, sortOrder])
  @@index([deletedAt])
}

model SeoMeta {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?  @db.Text
  ogImageUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([path])
}

// --- Phase 0 foundations (additive only) ---

enum AdminRole {
  owner
  editor
}

enum PublishStatus {
  draft
  in_review
  approved
  published
}

enum SourceStatus {
  to_verify
  verified
  rejected
}

model AdminUser {
  id        String    @id @default(cuid())
  email     String    @unique
  role      AdminRole @default(editor)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SiteSetting {
  id                      String    @id @default("default")
  foundationsUiEnabled    Boolean   @default(false)
  analyticsEnabled        Boolean   @default(false)
  demoKillSwitch          Boolean   @default(false)
  demoDailySpendCapUsd    Float     @default(5)
  demoSpikeAlertThreshold Int       @default(8)
  demoLastAlertSentAt     DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Source {
  id            String       @id @default(cuid())
  title         String
  publisher     String
  publishedDate String?
  url           String
  exactClaim    String?      @db.Text
  notes         String?      @db.Text
  status        SourceStatus @default(to_verify)
  verifiedBy    String?
  verifiedAt    DateTime?
  nextReviewAt  DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  links         SourceLink[]

  @@index([status])
}

model SourceLink {
  id         String   @id @default(cuid())
  sourceId   String
  source     Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([sourceId, targetType, targetId])
  @@index([targetType, targetId])
}

model Guide {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  industry       String        @default("general")
  summaryBox     String        @db.Text
  rogerNote      String?       @db.Text
  rogerStory     String?       @db.Text
  seoTitle       String?
  seoDescription String?       @db.Text
  reviewStamp    String?       @db.Text
  reviewedAt     DateTime?
  status         PublishStatus @default(draft)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sections       GuideSection[]

  @@index([status])
  @@index([industry])
}

model GuideSection {
  id             String   @id @default(cuid())
  guideId        String
  guide          Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  sortOrder      Int      @default(0)
  title          String
  job            String   @db.Text
  todaySteps     String   @db.Text
  tryItDemoSlug  String?
  whatStaysHuman String   @db.Text
  todayText      String   @db.Text
  years2to5Text  String   @db.Text
  years5to10Text String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([guideId, sortOrder])
}

model TimelineEntry {
  id          String        @id @default(cuid())
  timeframe   String
  industry    String        @default("general")
  title       String
  text        String        @db.Text
  status      PublishStatus @default(draft)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([timeframe, industry])
}

model Demo {
  id             String       @id @default(cuid())
  slug           String       @unique
  title          String
  description    String       @db.Text
  enabled        Boolean      @default(true)
  replayScript   Json
  restingMessage String       @default("Demo resting, back tomorrow.")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  samples        DemoSample[]

  @@index([enabled])
}

model DemoSample {
  id           String    @id @default(cuid())
  demoId       String
  demo         Demo      @relation(fields: [demoId], references: [id], onDelete: Cascade)
  label        String
  inputText    String    @db.Text
  cachedOutput String?   @db.Text
  generatedAt  DateTime?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([demoId, sortOrder])
}

model DemoUsageDay {
  id              String   @id @default(cuid())
  date            String   @unique
  spendUsd        Float    @default(0)
  generationCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AnalyticsDailyCount {
  id        String   @id @default(cuid())
  date      String
  eventName String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, eventName])
}
