# Database - Roger owns the Neon database
# Get your Neon connection string from: https://console.neon.tech
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/cerpamedia?sslmode=require"

# Resend API Key for sending magic link emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Secret for JWT token signing (generate with: openssl rand -base64 32)
AUTH_SECRET="your-random-secret-here-use-openssl-rand-base64-32"

# Admin email (only this email can access admin panel)
ADMIN_EMAIL="cerpamedia@gmail.com"

# Base URL for the application (needed for magic links)
# Development:
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Production (set in Vercel):
# NEXT_PUBLIC_BASE_URL="https://your-domain.com"
