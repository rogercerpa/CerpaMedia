# Database - Roger owns the Neon database
# Get your Neon connection string from: https://console.neon.tech
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/cerpamedia?sslmode=require"

# Resend API Key for sending magic link emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Sender for every Resend email (contact form, consult booking, admin magic link).
# Optional. When unset, mail is sent from CerpaMedia <info@cerpamedia.com>.
CONTACT_FROM_EMAIL="CerpaMedia <info@cerpamedia.com>"

# Reply-To on customer-facing emails. Optional. Defaults to cerpamedia@gmail.com.
# The contact-form notice to Roger replies to the submitter instead.
EMAIL_REPLY_TO="cerpamedia@gmail.com"

# Secret for JWT token signing (generate with: openssl rand -base64 32)
AUTH_SECRET="your-random-secret-here-use-openssl-rand-base64-32"

# Admin email (only this email can access admin panel)
ADMIN_EMAIL="cerpamedia@gmail.com"

# Base URL for the application (needed for magic links)
# Development:
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Production (set in Vercel):
# NEXT_PUBLIC_BASE_URL="https://your-domain.com"

# Stripe Payment Link for /consult page (optional)
# Canonical name (works in both server and client components):
NEXT_PUBLIC_STRIPE_PAYMENT_LINK="https://buy.stripe.com/..."
# Also supports (server components only):
# STRIPE_PAYMENT_LINK_URL="https://buy.stripe.com/..."

# Stripe secret key. Used by /consult checkout, the founding-spot counter,
# and signature verification setup for /api/webhooks/stripe.
# STRIPE_SECRET_KEY="sk_live_..."

# Signing secret for the existing Stripe webhook at /api/webhooks/stripe.
# Subscribe that endpoint to checkout.session.completed. The same route
# confirms $99 Strategy Call bookings and, for an AI Teammate Launch
# payment link, emails the buyer and Roger. No second webhook route is required.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Google Form shown as step 1 in the Launch welcome email.
# Optional. If unset, that step is left out and the admin alert says to
# send the intake link by hand.
# ATL_INTAKE_FORM_URL="https://docs.google.com/forms/d/e/..../viewform"

# Shared secret for the daily Launch setup-session reminder.
# Vercel Cron calls GET /api/cron/launch-setup-reminder at 14:00 UTC
# with Authorization: Bearer <CRON_SECRET>. Generate with:
# openssl rand -base64 32
# CRON_SECRET="..."
